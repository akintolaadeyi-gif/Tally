# Optional. Without it, Tally uses a simple built-in parser (fine for demos in English and Pidgin).
# With it, Claude turns what the trader said into a ledger entry, including Yoruba and mixed speech.
ANTHROPIC_API_KEY=

# Optional. The /transcribe address of Tally's speech server (speech-server/, running NaijaVox 2.0),
# e.g. https://yourname-tally-speech.hf.space/transcribe
# TRANSCRIBE_TOKEN must match API_TOKEN on the speech server, if you set one.
# Without it, the web app uses the browser's own speech recognition and the mobile app asks you to type.
TRANSCRIBE_URL=
TRANSCRIBE_TOKEN=
